{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "title": {
      "default": "PR desk",
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "repos": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9-]+\\/[A-Za-z0-9._-]+$"
      }
    },
    "groups": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "members": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9-]{0,38})(\\[bot\\])?$"
            }
          },
          "match": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 2
            }
          }
        },
        "required": [
          "key",
          "label"
        ]
      }
    },
    "community": {
      "default": {
        "label": "Community",
        "members": []
      },
      "type": "object",
      "properties": {
        "label": {
          "default": "Community",
          "type": "string",
          "minLength": 1
        },
        "members": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9-]{0,38})(\\[bot\\])?$"
          }
        }
      }
    },
    "defaultView": {
      "default": "community",
      "type": "string"
    },
    "targets": {
      "default": {
        "firstReviewDays": 2,
        "reReviewDays": 2,
        "mergeDays": 1
      },
      "type": "object",
      "properties": {
        "firstReviewDays": {
          "default": 2,
          "type": "number",
          "exclusiveMinimum": 0
        },
        "reReviewDays": {
          "default": 2,
          "type": "number",
          "exclusiveMinimum": 0
        },
        "mergeDays": {
          "default": 1,
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "businessDays": {
      "default": {
        "timezone": "UTC",
        "weekendDays": [
          5,
          6
        ]
      },
      "type": "object",
      "properties": {
        "timezone": {
          "default": "UTC",
          "type": "string",
          "minLength": 1
        },
        "weekendDays": {
          "default": [
            5,
            6
          ],
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 6
          }
        }
      }
    },
    "recentMergedDays": {
      "default": 14,
      "type": "integer",
      "minimum": 1,
      "maximum": 60
    },
    "historyDays": {
      "default": 30,
      "type": "integer",
      "minimum": 7,
      "maximum": 90
    },
    "bots": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "repos"
  ],
  "title": "pr-desk configuration"
}
