{
  "name": "pr-desk",
  "version": "0.1.0",
  "private": true,
  "description": "A public, support-queue style view of a team's open pull requests: whose turn it is, how long it has waited, and what's blocked.",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "sync": "tsx scripts/sync.ts",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.scripts.json",
    "check-config": "tsx scripts/check-config.ts"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@octokit/graphql": "^9.0.5",
    "@types/node": "^26.6.6",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.3.0",
    "autoprefixer": "^10.6.2",
    "postcss": "^8.5.33",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "zod": "^4.6.7"
  }
}
